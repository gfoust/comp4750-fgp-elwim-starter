{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Haskell: Load in GHCi",
      "type": "shell",
      "command": "ghci",
      "args": ["${file}"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Haskell: Run (runghc)",
      "type": "shell",
      "command": "runghc",
      "args": ["${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}